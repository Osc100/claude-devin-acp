[Unit]
Description=Devin as an OpenAI-compatible model and subagent steering for OpenCode (claude-devin-acp)
After=network.target

[Service]
ExecStart=%h/.local/bin/claude-devin-acp
WorkingDirectory=%h
# A user service does not get the login shell's PATH: devin must be on this one, or named by
# CLAUDE_DEVIN_DEVIN.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# It runs as the user; nothing it or Devin starts gains privileges (no sudo).
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
